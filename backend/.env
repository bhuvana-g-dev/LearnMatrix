# Copy this file to .env and fill in real values. .env is gitignored.

FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Path to your Firebase service account JSON (not committed).
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/serviceAccountKey.json

# Folder containing per-subject Excel question banks (Python.xlsx, etc.)
QUESTION_BANK_DIR=QuestionBank

# --- AI Agents (agents/) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_MAX_QUESTIONS_PER_REQUEST=20
AI_GENERATION_MAX_RETRIES=1
