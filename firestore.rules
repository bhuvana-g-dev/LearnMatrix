rules_version = '2';

// Reconstructed rules — the firestore.rules file in the uploaded zip was
// corrupted (it contained frontend/src/services/revisionService.js's
// JS content instead of rules), so there was no original to recover.
// This was built from what the CLIENT SDK actually touches directly
// (see frontend/src/services/directProfileReads.js and
// userProfileService.js) — everything else in this app goes through
// the Flask backend with the Admin SDK, which bypasses these rules
// entirely, so those collections need no client-facing rule at all.
// REVIEW BEFORE DEPLOYING — especially if any other screen reads/writes
// Firestore directly that this pass didn't find.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — profile fields not covered by Firebase Auth
    // (college, department, academicYear, mobile, avatarUrl, ...).
    // Read AND written directly by the client (userProfileService.js).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // roadmaps/{uid} — generated learning roadmap.
    // Client only ever READS this directly; every write goes through
    // the backend (services/roadmap_repository.py via Admin SDK).
    match /roadmaps/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // assessment_results/{uid} — saved diagnostic assessment.
    // Read directly by the client; written only by the backend.
    match /assessment_results/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // learning_activity/{uid} — { dates: [...] } day-level activity log.
    // Read directly by the client (activityService.js); the actual
    // ping-write goes through the backend's /api/activity/ping route
    // (Admin SDK — not affected by these rules either way).
    match /learning_activity/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // certificates/{uid} — issued/completed certificate state.
    // Read directly by the client; written only by the backend.
    match /certificates/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // topic_quiz_progress/{uid}__{skill}__{topic} — one doc per learner
    // per topic. Queried directly by the client with a Uid-equality
    // filter (directProfileReads.js's getRevisionsDirect), so the rule
    // has to check the document's own Uid field, not just the doc id.
    match /topic_quiz_progress/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.Uid;
      allow write: if false;
    }

    // Everything else (questions, lesson_plans, flashcard_sets,
    // learning_notes, learning_resources, ai_chat_history,
    // chat_sources, topic_quiz_attempts, ai_generated_questions,
    // topic_quiz_bank_cache, roles, skills, progress, ...) is only ever
    // touched server-side by the backend's Admin SDK, which bypasses
    // these rules entirely — so no client-facing rule is needed for
    // them, and the default-deny below correctly blocks any direct
    // client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
