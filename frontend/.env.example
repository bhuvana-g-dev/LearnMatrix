VITE_API_BASE_URL=http://localhost:5000/api

# Firebase (Project settings -> General -> Your apps -> SDK setup and
# configuration, in the Firebase console). These are safe to expose in
# client-side code by Firebase's own design — Firestore/Auth security
# comes from firestore.rules and server-side checks, not from hiding
# this config — but they still shouldn't be hardcoded in the repo, so
# every dev/deploy environment can point at its own Firebase project
# without a code change.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
